FROM golang:1.25-alpine

WORKDIR /app
# Air hiện yêu cầu Go 1.25+ để cài từ @latest.
RUN go install github.com/air-verse/air@latest

# Cache các thư viện
COPY go.mod go.sum ./
RUN go mod download || true

# Khi container chạy, gọi Air để tự động rerun code mỗi khi save file
CMD ["/go/bin/air", "-c", ".air.toml"]
